# Application
APP_NAME="Aetheria RPG"
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://rpg_user:secure_password@db:5432/aetheria_rpg
POSTGRES_USER=rpg_user
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=aetheria_rpg
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Inference API (AI)
INFERENCE_API_KEY=inference-your-api-key-here
INFERENCE_API_BASE_URL=https://api.inference.net/v1
INFERENCE_MODEL=google/gemma-3-27b-instruct
INFERENCE_MAX_TOKENS=250
INFERENCE_TEMPERATURE=0.7

# VK Mini Apps
VK_APP_ID=your_vk_app_id
VK_CLIENT_SECRET=your_vk_client_secret

# Security
JWT_SECRET_KEY=dev-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://vk.com,https://m.vk.com